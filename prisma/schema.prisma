generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  username                 String                   @unique
  password_hash            String                   @map("password_hash")
  tier                     String                   @default("FREE")
  access_expiry            DateTime?                @map("access_expiry")
  is_sovereign             Boolean                  @default(false) @map("is_sovereign")
  role                     UserRole                 @default(USER)
  is_founder               Boolean                  @default(false)
  institution_id           String?
  emailVerified            Boolean                  @default(false) @map("email_verified")
  verificationToken        String?                  @unique @map("verification_token")
  verificationTokenExpires DateTime?                @map("verification_token_expires")
  collaborative_sessions   collaborative_sessions[]
  conversations            Conversation[]
  posts                    Post[]
  institutions             institutions?            @relation(fields: [institution_id], references: [id])
  referral_code String?   @unique
  referred_by   String?
  referrer      User?     @relation("UserReferrals", fields: [referred_by], references: [id])
  referrals     User[]    @relation("UserReferrals")  


  @@map("users")
}

model Conversation {
  id              String          @id @default(uuid())
  user_id         String?         @map("user_id")
  title           String?
  is_public       Boolean         @default(false) @map("is_public")
  is_private      Boolean         @default(true) @map("is_private")
  council_members AIParticipant[]
  created_at      DateTime        @default(now()) @map("created_at")
  user            User?           @relation(fields: [user_id], references: [id])
  posts           Post[]

  @@map("conversations")
}

model Post {
  id              String         @id @default(uuid())
  content         String
  is_human        Boolean        @default(true) @map("is_human")
  name            String?
  ai_model        AIParticipant? @map("ai_model")
  user_id         String?        @map("user_id")
  conversation_id String         @map("conversation_id")
  parent_post_id  String?        @map("parent_post_id")
  created_at      DateTime       @default(now()) @map("created_at")
  conversation    Conversation   @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  parent          Post?          @relation("PostReplies", fields: [parent_post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Post[]         @relation("PostReplies")
  user            User?          @relation(fields: [user_id], references: [id])

  @@map("posts")
}

model collaborative_sessions {
  id                String         @id
  institution_id    String
  user_id           String?
  user_query        String
  raw_deliberations Json?
  cross_syntheses   Json?
  final_synthesis   String?
  chairperson_model AIParticipant?
  full_history      Json?
  share_token       String?        @unique
  is_public         Boolean        @default(false)
  created_at        DateTime       @default(now())
  institutions      institutions   @relation(fields: [institution_id], references: [id])
  users             User?          @relation(fields: [user_id], references: [id])
}

model institutions {
  id                     String                   @id
  name                   String
  slug                   String                   @unique
  color                  String                   @default("#6366f1")
  welcomeMessage         String
  systemPersonaBase      String
  domainRestriction      String?
  created_at             DateTime                 @default(now())
  collaborative_sessions collaborative_sessions[]
  users                  User[]
}

enum AIParticipant {
  GROK
  GEMINI
  CLAUDE
  GPT
  DEEPSEEK
  CHATGPT
  ANTHROPIC
}

enum UserRole {
  USER
  STUDENT
  FACULTY
  STAFF
  ADMIN
  GOD_MODE
  BETA_ARCHITECT
}
