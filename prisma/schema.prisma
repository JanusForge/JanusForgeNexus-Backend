generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Purchase {
  id              String   @id @default(uuid())
  userId          String
  amount          Float
  tokens          Int
  packageName     String
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model User {
  id                        String             @id @default(uuid())
  email                     String             @unique
  username                  String             @unique
  password_hash             String             @map("password_hash")
  tier                      String             @default("FREE")
  token_balance             Int                @default(0) @map("token_balance")
  tokens_used               Int                @default(0) @map("tokens_used")
  tokens_remaining          Int                @default(0) @map("tokens_remaining")
  refresh_token             String?            @map("refresh_token")
  created_at                DateTime           @default(now()) @map("created_at")
  updated_at                DateTime           @updatedAt @map("updated_at")
  role                      UserRole           @default(USER)
  reset_expires             DateTime?
  reset_token               String?            @unique
  resetToken                String?
  resetTokenExpiry          DateTime?
  purchases                 Purchase[]
  ai_responses              AIResponse[]
  debate_votes              DebateVote[]
  posts                     Post[]
  token_transactions        TokenTransaction[]
  conversations             Conversation[]     // Relation back to private conversations
  emailVerified             Boolean            @default(false)
  verificationToken         String?            @unique
  verificationTokenExpires  DateTime?

  @@map("users")
}


model Conversation {
  id              String          @id @default(uuid())
  user_id         String?         @map("user_id") 
  title           String?         // Will store the cinematic 3-5 word titles
  
  // ISOLATION LOGIC
  is_private      Boolean         @default(true) @map("is_private") // True for Nexus Prime
  is_daily_forge  Boolean         @default(false) @map("is_daily_forge") // False for Nexus Prime
  
  daily_topic     String?         @map("daily_topic")
  forge_date      DateTime?       @map("forge_date")
  council_members AIParticipant[] @map("council_members")
  created_at      DateTime        @default(now()) @map("created_at")
  expires_at      DateTime?       @map("expires_at")
  
  // RELATIONS
  daily_forges    DailyForge[]
  debate_votes    DebateVote[]    @relation("ConversationVotes")
  posts           Post[]          @relation("ConversationPosts")
  user            User?           @relation(fields: [user_id], references: [id])

  @@map("conversations")
}

model Post {
  id              String         @id @default(uuid())
  content         String         @db.Text // Use Text for long adversarial syntheses
  is_human        Boolean        @default(true) @map("is_human")
  
  // IDENTIFICATION
  name            String?        // NEW: Stores "Claude", "GPT4", etc. for the chat UI
  ai_model        AIParticipant? @map("ai_model")
  user_id         String?        @map("user_id")
  conversation_id String         @map("conversation_id")
  
  parent_post_id  String?        @map("parent_post_id")
  likes           Int            @default(0)
  required_tier   String?        @map("required_tier")
  created_at      DateTime       @default(now()) @map("created_at")
  ai_response     AIResponse?    @relation("PostToAIResponse")

  // RELATIONS & CLEANUP
  conversation    Conversation   @relation("ConversationPosts", fields: [conversation_id], references: [id], onDelete: Cascade)
  parent          Post?          @relation("PostReplies", fields: [parent_post_id], references: [id])
  replies         Post[]         @relation("PostReplies")
  user            User?          @relation(fields: [user_id], references: [id])

  @@map("posts")
}



model AIResponse {
  id              String        @id @default(uuid())
  post_id         String        @unique @map("post_id")
  ai_model        AIParticipant @map("ai_model")
  raw_response    String        @map("raw_response")
  processing_time Int           @map("processing_time")
  tokens_used     Int           @map("tokens_used")
  cost_cents      Int           @map("cost_cents")
  user_id         String        @map("user_id")
  created_at      DateTime      @default(now()) @map("created_at")
  
  // CASCADE: If post is deleted, delete the AI response data
  post            Post          @relation("PostToAIResponse", fields: [post_id], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [user_id], references: [id])

  @@map("ai_responses")
}

model DebateVote {
  id              String        @id @default(uuid())
  user_id         String        @map("user_id")
  conversation_id String        @map("conversation_id")
  ai_model        AIParticipant @map("ai_model")
  score           Int
  created_at      DateTime      @default(now()) @map("created_at")
  
  // CASCADE: Deleting conversation wipes votes
  conversation    Conversation  @relation("ConversationVotes", fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [user_id], references: [id])

  @@unique([user_id, conversation_id, ai_model])
  @@map("debate_votes")
}

model TokenTransaction {
  id               String   @id @default(uuid())
  user_id          String   @map("user_id")
  amount           Int
  transaction_type String   @map("transaction_type")
  description      String?
  created_at       DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [user_id], references: [id])

  @@map("token_transactions")
}

model DailyForge {
  id               String        @id @default(uuid())
  date             DateTime      @default(now())
  scoutedTopics    String
  winningTopic     String
  councilVotes     String
  openingThoughts  String?
  phase            String        @default("INITIALIZED")
  nextReset        DateTime?
  conversationId   String?       @map("conversationId")
  conversation     Conversation? @relation(fields: [conversationId], references: [id])

  @@map("DailyForge")
}

enum AIParticipant {
  GROK
  GEMINI_PRO
  CLAUDE
  CHATGPT
  DEEPSEEK
}

enum UserRole {
  USER
  ADMIN
  GOD_MODE
  BETA_ARCHITECT
}
