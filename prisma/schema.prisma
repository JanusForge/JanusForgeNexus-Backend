generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum AIParticipant {
  GROK
  GEMINI_PRO
  CLAUDE
  CHATGPT
  DEEPSEEK
}

// Add this model to your schema.prisma file
model Purchase {
  id              String   @id @default(uuid())
  userId          String
  amount          Float
  tokens          Int
  packageName     String
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
  
  // Relationship to the User table
  user            User     @relation(fields: [userId], references: [id])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password_hash String   @map("password_hash")
  tier          String   @default("FREE")
  purchases        Purchase[]

  
  // --- NEW UNIFIED TOKEN SYSTEM ---
  token_balance    Int   @default(0) @map("token_balance")
  tokens_used      Int   @default(0) @map("tokens_used")      // Track spending
  tokens_remaining Int   @default(0) @map("tokens_remaining") // Track fuel
  
  refresh_token String?  @map("refresh_token")
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")
  
  // --- KEEP THESE RELATIONSHIPS (Crucial for Site Functionality) ---
  posts              Post[]
  ai_responses       AIResponse[]
  debate_votes       DebateVote[]
  token_transactions TokenTransaction[]

  @@map("users")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String?
  is_daily_forge Boolean   @default(false) @map("is_daily_forge")
  daily_topic String?   @map("daily_topic")
  forge_date  DateTime? @map("forge_date")
  council_members AIParticipant[] @map("council_members")
  created_at  DateTime  @default(now()) @map("created_at")
  expires_at  DateTime? @map("expires_at")
  posts       Post[]
  debate_votes DebateVote[]
  @@map("conversations")
}

model Post {
  id              String    @id @default(uuid())
  content         String    @db.Text
  is_human        Boolean   @default(true) @map("is_human")
  ai_model        AIParticipant? @map("ai_model")
  user_id         String?   @map("user_id")
  conversation_id String    @map("conversation_id")
  parent_post_id  String?   @map("parent_post_id")
  likes           Int       @default(0)
  required_tier   String?   @map("required_tier")
  created_at      DateTime  @default(now()) @map("created_at")
  user            User?     @relation(fields: [user_id], references: [id])
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  parent          Post?     @relation("PostReplies", fields: [parent_post_id], references: [id])
  replies         Post[]    @relation("PostReplies")
  ai_response     AIResponse?
  @@map("posts")
}

model AIResponse {
  id              String    @id @default(uuid())
  post_id         String    @unique @map("post_id")
  ai_model        AIParticipant @map("ai_model")
  raw_response    String    @db.Text @map("raw_response")
  processing_time Int       @map("processing_time")
  tokens_used     Int       @map("tokens_used")
  cost_cents      Int       @map("cost_cents")
  user_id         String    @map("user_id")
  created_at      DateTime  @default(now()) @map("created_at")
  post            Post      @relation(fields: [post_id], references: [id])
  user            User      @relation(fields: [user_id], references: [id])
  @@map("ai_responses")
}

model DebateVote {
  id              String    @id @default(uuid())
  user_id         String    @map("user_id")
  conversation_id String    @map("conversation_id")
  ai_model        AIParticipant @map("ai_model")
  score           Int
  created_at      DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [user_id], references: [id])
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  @@unique([user_id, conversation_id, ai_model])
  @@map("debate_votes")
}

model TokenTransaction {
  id              String    @id @default(uuid())
  user_id         String    @map("user_id")
  amount          Int
  transaction_type String   @map("transaction_type")
  description     String?
  created_at      DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [user_id], references: [id])
  @@map("token_transactions")
}

model TierConfiguration {
  id        String   @id @default(uuid())
  tier      String   @unique
  ai_models String[] @map("ai_models")  // Changed from AIParticipant[]
  token_allowance Int @map("token_allowance")
  price_cents Int    @map("price_cents")
  @@map("tier_configurations")
}

model DailyForge {
  id             String   @id @default(uuid())
  date           DateTime @default(now())
  scoutedTopics  String   // JSON string of the 3 topics found by the Scout
  winningTopic   String   // The topic selected by the Council
  councilVotes   String   // JSON string: { "Claude": "Topic A", "Grok": "Topic B" }
  openingThoughts String?  // Initial AI comments to hook the user
  phase          String   @default("INITIALIZED") // SCOUTING, VOTING, or INITIALIZED
}
