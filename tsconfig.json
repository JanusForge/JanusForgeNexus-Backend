{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "src/types/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "express", "bcryptjs", "jsonwebtoken"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "src/lib/councilDebate.ts",
    "src/routes/admin.ts",
    "src/routes/archives.ts",
    "src/routes/debates.ts",
    "src/routes/conversations.ts",
    "src/routes/passwordReset.ts",
    "src/scripts",
    "src/simulateForge.ts",
    "src/services/nexus-core/nexus-router.ts"
  ]
}
